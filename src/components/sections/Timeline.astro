---
import { t } from '../../utils/i18n';

interface Props {
  lang: string | undefined;
}

const { lang } = Astro.props;

// order by start date, except for `catalist` which is currently ongoing
const timelineItems = [
  { id: "catalist", concurrent: false },
  { id: "sopheva", concurrent: "catalist" },
  { id: "pc", concurrent: "catalist" },
  { id: "ga", concurrent: "catalist" },
  { id: "bah", concurrent: false },
  { id: "internship", concurrent: "wlu" },
  { id: "helpdesk", concurrent: "wlu" },
  { id: "condor", concurrent: "wlu" },
  { id: "its", concurrent: "wlu" },
  { id: "wlu", concurrent: false },
] as const;
---

<section id="career" class="py-16 md:py-24">
  <div class="max-w-container mx-auto px-6">
    <div class="mb-12" data-aos="fade-up">
      <h2 class="font-heading text-h2 text-secondary dark:text-white mb-4">{t('timeline.title', lang)}</h2>
      <p class="text-secondary/70 dark:text-white/70 max-w-2xl">
        {t('timeline.subtitle', lang)}
      </p>
    </div>

    <div id="timeline-container" class="relative"> {/* Added id for GSAP trigger */}
      <!-- Timeline line -->
      <div class="absolute left-0 md:left-1/2 top-0 bottom-0 w-px bg-gray-200 dark:bg-gray-700 transform md:-translate-x-1/2"></div>

      <div class="space-y-12">
        {timelineItems.map((item, index) => (
          <div
            class={`relative flex flex-col md:flex-row gap-8 md:gap-0 ${index % 2 === 0 ? 'md:flex-row-reverse' : ''}`}
            data-aos={index % 2 === 0 ? "fade-left" : "fade-right"}
          >
            {/* Timeline dot - Added class="timeline-dot" */}
            <div class="timeline-dot absolute left-0 md:left-1/2 top-0 w-5 h-5 rounded-full border-4 border-white dark:border-neutral-dark transform -translate-x-2 md:-translate-x-2.5 bg-primary"></div>

            <!-- Content -->
            <div class="md:w-1/2 pl-10 md:pl-0 md:pr-12 md:text-right">
              <span class="inline-block font-mono text-xs text-primary mb-2 uppercase tracking-wider">{t(`timeline.${item.id}.period`, lang)}</span>
              {item.concurrent && (
                <span class="block md:inline-block md:ml-2 px-3 py-1 text-xs font-mono bg-primary/20 text-primary rounded-full mb-2">
                  {t(`timeline.concurrentBadge.${item.concurrent}`, lang)}
                </span>
              )}
              <h3 class="font-heading text-xl text-secondary dark:text-white mb-1">{t(`timeline.${item.id}.title`, lang)}</h3>
              <h4 class="font-medium text-secondary/80 dark:text-white/80 mb-2">{t(`timeline.${item.id}.company`, lang)}</h4>
              <p class="text-secondary/70 dark:text-white/70">{t(`timeline.${item.id}.description`, lang)}</p>
            </div>

            <div class="md:w-1/2 md:pl-12">
              <!-- Empty div to create the layout on alternating sides -->
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    const timelineDots = document.querySelectorAll('.timeline-dot'); // Selector is now correct

    gsap.from(timelineDots, {
      scrollTrigger: {
        trigger: '#timeline-container', // Corrected trigger
        start: 'top 80%',
      },
      scale: 0,
      opacity: 0,
      duration: 0.5,
      stagger: 0.2,
      ease: 'back.out(1.7)'
    });
  });
</script>
